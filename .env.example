# Postgres connection used by the pipeline. Local default shown. For Supabase use the session
# pooler as the pipeline role:
# postgresql://safescale_pipeline.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://localhost/safescale

# Used by integration tests only (a database that tests may wipe).
TEST_DATABASE_URL=postgresql://localhost/safescale_test
